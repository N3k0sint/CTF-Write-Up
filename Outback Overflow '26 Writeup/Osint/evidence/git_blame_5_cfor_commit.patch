From 6c7b98766dbe9e836ac82beb4fc8cecd50e4a6d9 Mon Sep 17 00:00:00 2001
From: "Jake M." <jakeyb0i-qld.dev@example.com>
Date: Tue, 20 Oct 2026 23:58:00 +1000
Subject: [PATCH] hotfix: longer timeout for prod (testing)

---
 app/main.py     | 2 +-
 config/prod.env | 4 ++++
 2 files changed, 5 insertions(+), 1 deletion(-)
 create mode 100644 config/prod.env

diff --git a/app/main.py b/app/main.py
index 1c7fe41..f8bc94b 100644
--- a/app/main.py
+++ b/app/main.py
@@ -16,7 +16,7 @@ def status():
     results = {}
     for name, url in SERVICES.items():
         try:
-            r = requests.get(url, timeout=5)
+            r = requests.get(url, timeout=10)
             results[name] = "up" if r.ok else f"down ({r.status_code})"
         except requests.RequestException:
             results[name] = "unreachable"
diff --git a/config/prod.env b/config/prod.env
new file mode 100644
index 0000000..79cdd26
--- /dev/null
+++ b/config/prod.env
@@ -0,0 +1,4 @@
+# TEMP - testing hotfix against prod, DO NOT MERGE
+PROD_DB_HOST=db01.outbackcorp.internal
+PROD_DB_USER=svc_urlchecker
+PROD_DB_PASS=OO{f0rks_sh4r3_m0r3_th4n_y0u_th1nk}
